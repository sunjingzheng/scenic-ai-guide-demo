# Mock API
HOST=localhost
PORT=8787

# Vite proxy target for /api during local development
API_HOST=localhost
API_PORT=8787
WEB_HOST=localhost
WEB_PORT=5173
PREVIEW_PORT=4173

# Optional source data package. Relative paths are resolved from this project root.
DATA_PACK_DIR=./source-data

# Optional local TTS service
TTS_ENABLED=false
TTS_URL=http://localhost:9880
TTS_SPEAKER=xiaoxiao
TTS_LANGUAGE=Auto

# Optional Live2D assets. Defaults load Hiyori from luckui/ai-live2d-go via jsDelivr.
VITE_LIVE2D_ASSET_BASE=https://cdn.jsdelivr.net/gh/luckui/ai-live2d-go@nightly/public
# VITE_LIVE2D_MODEL_URL=/live2d/Resources/Hiyori_pro/hiyori_pro_t11.model3.json
# VITE_LIVE2D_CORE_URL=/live2d/Core/live2dcubismcore.js
VITE_PIXI_URL=https://cdn.jsdelivr.net/npm/pixi.js@6.5.10/dist/browser/pixi.min.js
VITE_PIXI_LIVE2D_URL=https://cdn.jsdelivr.net/npm/pixi-live2d-display@0.4.0/dist/cubism4.min.js
